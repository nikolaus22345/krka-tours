# EmailJS — contact form (https://www.emailjs.com)
# Required on Vercel for the contact form to work.
# Copy these to Vercel → Project → Settings → Environment Variables (Production + Preview).

EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
INQUIRY_TO_EMAIL=zagrebtransfers.hr@gmail.com
